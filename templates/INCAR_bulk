# ============================================================
# INCAR -- 体相（bulk）计算模板
# 适用于: UO2 / MoO2 / NbO2 / ZrO2 / TiO2 / O2 分子
# 参考: Chen & Kaltsoyannis, Appl. Surf. Sci. 537 (2021) 147972
# ============================================================
SYSTEM  = BULK
PREC    = Accurate
ENCUT   = 650
EDIFF   = 1E-7
EDIFFG  = -0.01
ISMEAR  = 0
SIGMA   = 0.05
LREAL   = .FALSE.

# --- DFT+U (Dudarev) ---
LDAU      = .TRUE.
LDAUTYPE  = 2
LDAUL     = 3 -1
LDAUU     = 4.5 0.0
LDAUJ     = 0.5 0.0
LMAXMIX   = 4

# --- Magnetism ---
ISPIN   = 2
# MAGMOM 请按结构填写，例如 UO2 原胞:
# MAGMOM  = 2*2.0 2*-2.0 8*0.0

# --- Ionic relaxation (全弛豫) ---
NSW     = 100
IBRION  = 2
ISIF    = 3

# --- Parallel ---
NCORE   = 8

# --- Output ---
LWAVE   = .TRUE.
LCHARG  = .TRUE.
LORBIT  = 11
