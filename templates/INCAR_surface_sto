# ============================================================
# INCAR -- 化学计量比表面计算模板
# 适用于: UO2 表面 (ISIF=3) 与 U1-yMyO2 表面 (ISIF=2)
# 参考: Chen & Kaltsoyannis, Appl. Surf. Sci. 537 (2021) 147972
# ============================================================
SYSTEM  = SURFACE_STOICHIOMETRIC
PREC    = Accurate
ENCUT   = 650
EDIFF   = 1E-6
EDIFFG  = -0.02
ISMEAR  = 0
SIGMA   = 0.05
LREAL   = .FALSE.

# --- DFT+U (Dudarev) ---
LDAU      = .TRUE.
LDAUTYPE  = 2
# U: l=3 (f), O: -1 (不加); 掺杂元素按需(默认 -1)
LDAUL     = 3 -1 -1
LDAUU     = 4.5 0.0 0.0
LDAUJ     = 0.5 0.0 0.0
LMAXMIX   = 4

# --- Magnetism (collinear AFM) ---
ISPIN   = 2
# 6 层 slab，1/3/5 层 +2.0，2/4/6 层 -2.0 (每层 4 U):
# MAGMOM  = 4*2.0 4*-2.0 4*2.0 4*-2.0 4*2.0 4*-2.0 48*0.0
# 注意: 原子顺序含掺杂元素时调整

# --- Ionic relaxation ---
NSW     = 200
IBRION  = 2
# 纯 UO2 表面用 ISIF=3; MOX 及含缺陷体系必须用 ISIF=2
ISIF    = 2

# --- Parallel ---
NCORE   = 8

# --- Output ---
LWAVE   = .TRUE.
LCHARG  = .TRUE.
LORBIT  = 11
